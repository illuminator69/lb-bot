# lb-bot configuration.
#
# Copy to `.env` next to docker-compose.yml and fill in. Docker Compose reads it
# automatically. `.env` is gitignored — keep it that way, it holds credentials.
#
#   cp .env.example .env
#   docker compose up -d
#
# Everything not listed here has a working default (see README.md).

# lb-bot names any empty REQUIRED setting (the name only) in one start-up log line
# and in `missingConfig` on /api/health.

# ─── Navidrome (REQUIRED) ─────────────────────────────────────────────────────
# The library lb-bot reads, and the oracle it uses to confirm a placement landed.
# lb-bot's web UI also signs people in with their Navidrome login: any Navidrome
# user may sign in, and only Navidrome admins get the actions that change files.
# Sessions live in memory, so restarting lb-bot signs everyone out.
# Use the container/LAN address — this is server-to-server, it never needs to be
# public.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=your-navidrome-username
NAVIDROME_PASSWORD=your-navidrome-password

# ─── slskd (Soulseek) (optional) ──────────────────────────────────────────────
# The acquisition backend. Downloading is ON only when SLSKD_API_KEY is set (read
# once at start). Leave it blank and lb-bot makes no slskd call at all: every
# download route answers 409 `downloads_off`, and the clients show the wishlist
# and "Find it" links instead. Generate the key in the slskd UI: Options → API Keys.
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=

# ─── MusicBrainz ──────────────────────────────────────────────────────────────
# REQUIRED. The MusicBrainz API terms of service require a contact address in the
# User-Agent; requests without one get rate-limited or blocked. Any address you
# actually read is fine.
MBZ_CONTACT=you@example.com

# ─── ListenBrainz (optional) ──────────────────────────────────────────────────
# Drives the weekly-playlist and fresh-release sources, the listening history (shown
# to the hub's primary user only), and the similar-artists lookup behind "Similar
# albums". Unset, no playlist scan runs.
LISTENBRAINZ_USER=your-listenbrainz-username

# ─── Telegram (optional) ──────────────────────────────────────────────────────
# The bot's own control surface. Leave both blank to run web-UI-only; a rejected
# token is skipped, and the web UI and every worker start first either way.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── navi-connect hub (REQUIRED) ───────────────────────────────────────────────
# The clients reach lb-bot only through the hub. One shared secret works both ways:
# lb-bot sends it with its pushes (album landed, index and fill progress), and the
# hub sends it back as `Authorization: Bearer` on every /lb/* call, telling lb-bot
# which signed-in user is calling. Without the token every hub call except
# /api/health is refused (401); without the URL lb-bot sends no pushes, so the
# clients show no index progress.
#
# LB_BOT_HUB_URL is the hub's *http* address (not the ws:// one the clients use),
# and the token must be byte-identical to the hub's HUB_TOKEN. Deploy a new lb-bot
# before a new hub.
LB_BOT_HUB_URL=
LB_BOT_HUB_TOKEN=

# ─── Optional enrichment ──────────────────────────────────────────────────────
# Last.fm cross-checks the ListenBrainz similar-artists lookup. Without it the
# ListenBrainz half runs alone and the shelf still works.
LASTFM_API_KEY=

# AcoustID fingerprint check at placement: a different song under the right name
# is refused instead of filed. Free key from https://acoustid.org/new-application.
# Without it nothing is checked and nothing is refused on that ground.
ACOUSTID_API_KEY=

# Spotify public-playlist import (Client Credentials flow). Both or neither.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Tuning (defaults are fine; see README "Keeping the polled path cheap") ───
# How long a discography index row is trusted before a rescan is offered.
#LB_BOT_INDEX_TTL_DAYS=30

# slskd search behaviour. SLSKD_SEARCH_TIMEOUT must outlast slskd's own straggler
# timeout — results are unreadable until the search completes.
#SLSKD_SEARCH_TIMEOUT=75
#SLSKD_SEARCH_MIN_RESPONSES=5
#SLSKD_SEARCH_MIN_WAIT=5
#SLSKD_SEARCH_SETTLE=25

# How long a review group's ranked source list is reused before re-searching.
#SOURCE_RESULTS_TTL=180
